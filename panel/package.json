{
  "name": "flick-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Web panel for Flick Server: one page per component, FlickSync first",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/gen-tokens.mjs && next build",
    "start": "node start.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}