# Flick Server configuration. Copy to `.env`; docker compose reads it.
# Everything is optional. Lines starting with "#" show a setting that is off or unset by default.
#
#   1. SYSTEM            process-wide: network, logs, storage, metrics
#   2. WEB PANEL         the optional Next.js panel
#   3. MODULE: FLICKSYNC Watch Together (access, rooms, sync, chat, limits)

################################################################################
# 1. SYSTEM
################################################################################

# ---- Network
FLICKSYNC_HOST=0.0.0.0
FLICKSYNC_PORT=8787

# ---- Logging
# tracing filter, e.g. "info" or "info,flicksync::room=debug"
FLICKSYNC_LOG_LEVEL=info
# pretty | json
#FLICKSYNC_LOG_FORMAT=pretty

# ---- Storage
# Where the generated signing key lives (file `auth_keys`, mode 0600). Keep it on a volume.
#FLICKSYNC_DATA_DIR=./data

# ---- Metrics
# Prometheus text on GET /metrics.
FLICKSYNC_METRICS_ENABLED=false
# If set, /metrics needs "Authorization: Bearer <token>".
FLICKSYNC_METRICS_TOKEN=

# ---- Internals
# Seconds between maintenance passes (expiry, heartbeats).
FLICKSYNC_SWEEP_INTERVAL_MS=1000
# Seconds to let sockets drain on shutdown.
FLICKSYNC_SHUTDOWN_GRACE=10

################################################################################
# 2. WEB PANEL  (docs: panel/README.md)
################################################################################

# Master switch. When false the panel container exits at once and nothing listens.
ENABLE_WEB_PANEL=false
# Sign-in password. Required when enabled. 10+ characters: openssl rand -base64 18
#PANEL_PASSWORD=
# Secret shared by the panel and FlickSync's admin API (docs/admin-api.md).
# Required when enabled; leave unset to keep the admin API off. 16+ characters: openssl rand -base64 32
#FLICKSYNC_ADMIN_TOKEN=

################################################################################
# 3. MODULE: FLICKSYNC
################################################################################

# ---- Access: invitation link and signing key
# Public address clients use. Needed behind a reverse proxy, where the server cannot know it.
# Without it the invitation uses the bind address over plain http.
#FLICKSYNC_PUBLIC_URL=https://sync.example.com
# Same, when a proxy serves FlickSync under a path prefix and strips it:
#FLICKSYNC_PUBLIC_URL=https://flick.example.com/sync
#
# Show the invitation:  docker compose exec flicksync flicksync invite
# Rotate the key:       flicksync invite --rotate   (then restart)

# ---- Access: your own keys (optional)
# Unset = FlickSync generates and stores a key. Setting either variable below disables that.
# Format, comma or newline separated:  kid:server_id:secret
#   kid        key id, sent in the JWT header
#   server_id  the Flick Server that owns the key; tokens must carry the same claim
#   secret     32+ characters: openssl rand -base64 48
# Rotation: add a second key (same server_id), switch the issuer, remove the old one.
#FLICKSYNC_AUTH_KEYS=main:my-flick-server:CHANGE-ME-use-at-least-32-random-characters
# Same, from a file with one key per line (Docker/Kubernetes secrets).
#FLICKSYNC_AUTH_KEYS_FILE=/run/secrets/flicksync_keys
# Required `aud` claim.
FLICKSYNC_AUTH_AUDIENCE=flicksync
# Refuse tokens that expire further ahead than this (seconds).
FLICKSYNC_AUTH_MAX_TOKEN_TTL=86400
# Clock skew tolerance (seconds).
FLICKSYNC_AUTH_LEEWAY=30

# ---- Rooms
# Participants per room, reconnecting ones included.
FLICKSYNC_MAX_ROOM_SIZE=100
# Rooms alive at once.
FLICKSYNC_MAX_ROOMS=10000
# Rooms one user may create per minute (also the burst).
FLICKSYNC_ROOM_CREATE_PER_MINUTE=6
# Seconds an empty room lives before it is deleted.
FLICKSYNC_ROOM_TIMEOUT=60
# Seconds without any client message before a room expires.
FLICKSYNC_ROOM_IDLE_TIMEOUT=43200
# Seconds a dropped participant keeps their seat.
FLICKSYNC_RECONNECT_GRACE=30
# Seconds a participant who joined over HTTP has to open their WebSocket.
FLICKSYNC_CONNECT_GRACE=60
# When the host leaves for good: transfer | close
FLICKSYNC_HOST_LEAVE_POLICY=transfer
# Who controls playback by default: everyone | host_only
FLICKSYNC_DEFAULT_CONTROL_MODE=everyone

# ---- Sync
# Drift thresholds in ms (0 < IGNORE < SOFT < HARD):
#   under IGNORE  nothing             under SOFT  gentle speed change
#   under HARD    stronger speed change             HARD and over  hard seek
FLICKSYNC_SYNC_DRIFT_IGNORE=100
FLICKSYNC_SYNC_DRIFT_SOFT=500
FLICKSYNC_SYNC_DRIFT_HARD=1500
# Speed change of the two bands (0.03 = 3%).
FLICKSYNC_SYNC_RATE_SOFT=0.03
FLICKSYNC_SYNC_RATE_STRONG=0.08
# Minimum ms between two hard seeks of one participant.
FLICKSYNC_SYNC_SEEK_COOLDOWN_MS=3000
# Seconds between sync heartbeats while a room plays.
FLICKSYNC_SYNC_HEARTBEAT=10
# Accepted playback speed range.
FLICKSYNC_RATE_MIN=0.25
FLICKSYNC_RATE_MAX=4.0
# Furthest seekable position (seconds).
FLICKSYNC_MAX_POSITION=604800

# ---- Chat
FLICKSYNC_CHAT_ENABLED=true
# Characters per message.
FLICKSYNC_CHAT_MAX_LENGTH=500
# Messages kept per room.
FLICKSYNC_CHAT_HISTORY=100
# Per user: sustained messages per second, and burst.
FLICKSYNC_CHAT_RATE_PER_SEC=1
FLICKSYNC_CHAT_BURST=5

# ---- Connections and abuse limits
# Simultaneous WebSocket connections.
FLICKSYNC_MAX_CONNECTIONS=10000
# Largest inbound message (bytes).
FLICKSYNC_WS_MAX_MESSAGE_BYTES=16384
# Server ping interval, and the silence after which a peer is dropped (seconds).
FLICKSYNC_WS_PING_INTERVAL=20
FLICKSYNC_WS_IDLE_TIMEOUT=60
# Per connection: messages per second, burst, and rate-limit violations in a row before the socket closes.
FLICKSYNC_MSG_RATE_PER_SEC=20
FLICKSYNC_MSG_BURST=40
FLICKSYNC_WS_RATE_LIMIT_STRIKES=20
# Outbound queue per connection. A connection that fills it is dropped as too slow.
FLICKSYNC_WS_OUTBOUND_BUFFER=256

# ---- Browser access (CORS)
# Allowed browser origins, comma separated. Empty = none. Native clients are unaffected. "*" is refused.
FLICKSYNC_CORS_ORIGINS=
