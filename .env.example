# FlickSync configuration. Copy to `.env` (docker compose reads it) and adjust.
# Every variable is optional except FLICKSYNC_AUTH_KEYS.

# ---------------------------------------------------------------- network
FLICKSYNC_HOST=0.0.0.0
FLICKSYNC_PORT=8787

# ---------------------------------------------------------------- logging
# tracing EnvFilter syntax, e.g. "info" or "info,flicksync::room=debug"
FLICKSYNC_LOG_LEVEL=info
# pretty | json
#FLICKSYNC_LOG_FORMAT=pretty

# ---------------------------------------------------------------- authentication (REQUIRED)
# Signing keys, comma or newline separated:  kid:flick_server_id:secret
#  * kid        identifies the key (put the same kid in the JWT header)
#  * server_id  the Flick Server that owns the key; tokens must carry the same `server_id` claim
#  * secret     at least 32 characters, e.g. `openssl rand -base64 48`
# Rotation: add a second key (new kid, same server_id), switch the Flick Server to it,
# then remove the old key. See docs/flick-integration.md.
FLICKSYNC_AUTH_KEYS=main:my-flick-server:CHANGE-ME-use-at-least-32-random-characters
# Alternative for Docker/Kubernetes secrets: a file with one key per line.
#FLICKSYNC_AUTH_KEYS_FILE=/run/secrets/flicksync_keys
# Required `aud` claim of tokens.
FLICKSYNC_AUTH_AUDIENCE=flicksync
# Tokens expiring further in the future than this (seconds) are refused.
FLICKSYNC_AUTH_MAX_TOKEN_TTL=86400
# Clock skew tolerance (seconds).
FLICKSYNC_AUTH_LEEWAY=30

# ---------------------------------------------------------------- rooms
# Participants per room (reconnecting ones included).
FLICKSYNC_MAX_ROOM_SIZE=100
# Rooms alive at once on this instance.
FLICKSYNC_MAX_ROOMS=10000
# Rooms one user may create per minute (also the burst size).
FLICKSYNC_ROOM_CREATE_PER_MINUTE=6
# Seconds an EMPTY room lingers before destruction.
FLICKSYNC_ROOM_TIMEOUT=60
# Seconds without any client message after which a room expires.
FLICKSYNC_ROOM_IDLE_TIMEOUT=43200
# Seconds a dropped participant keeps their seat (reconnection grace period).
FLICKSYNC_RECONNECT_GRACE=30
# Seconds a participant who joined over HTTP has to open their WebSocket.
FLICKSYNC_CONNECT_GRACE=60
# What happens when the host leaves for good: transfer | close
FLICKSYNC_HOST_LEAVE_POLICY=transfer
# Who may play/pause/seek/change rate by default: everyone | host_only
FLICKSYNC_DEFAULT_CONTROL_MODE=everyone

# ---------------------------------------------------------------- synchronization
# Drift thresholds in milliseconds (0 < IGNORE < SOFT < HARD).
#  < IGNORE  nothing        < SOFT  gentle rate adjustment
#  < HARD    stronger rate adjustment                >= HARD  hard seek
FLICKSYNC_SYNC_DRIFT_IGNORE=100
FLICKSYNC_SYNC_DRIFT_SOFT=500
FLICKSYNC_SYNC_DRIFT_HARD=1500
# Relative rate change used by the two rate bands (0.03 = +-3%).
FLICKSYNC_SYNC_RATE_SOFT=0.03
FLICKSYNC_SYNC_RATE_STRONG=0.08
# Minimum time between two hard seeks of the same participant.
FLICKSYNC_SYNC_SEEK_COOLDOWN_MS=3000
# Seconds between sync_state heartbeats while a room is playing.
FLICKSYNC_SYNC_HEARTBEAT=10
# Accepted playback rate range and maximum seekable position (seconds).
FLICKSYNC_RATE_MIN=0.25
FLICKSYNC_RATE_MAX=4.0
FLICKSYNC_MAX_POSITION=604800

# ---------------------------------------------------------------- chat
FLICKSYNC_CHAT_ENABLED=true
FLICKSYNC_CHAT_MAX_LENGTH=500
FLICKSYNC_CHAT_HISTORY=100
FLICKSYNC_CHAT_RATE_PER_SEC=1
FLICKSYNC_CHAT_BURST=5

# ---------------------------------------------------------------- WebSocket / abuse limits
# Largest accepted inbound message in bytes.
FLICKSYNC_WS_MAX_MESSAGE_BYTES=16384
# Server-sent WebSocket ping interval and the silence after which a peer is dropped (seconds).
FLICKSYNC_WS_PING_INTERVAL=20
FLICKSYNC_WS_IDLE_TIMEOUT=60
# Per-connection inbound rate limit (messages/s sustained, burst) and the number of
# consecutive violations after which the socket is closed.
FLICKSYNC_MSG_RATE_PER_SEC=20
FLICKSYNC_MSG_BURST=40
FLICKSYNC_WS_RATE_LIMIT_STRIKES=20
# Simultaneous WebSocket connections on this instance.
FLICKSYNC_MAX_CONNECTIONS=10000
# Outbound queue per connection; a connection that fills it is dropped as a slow consumer.
FLICKSYNC_WS_OUTBOUND_BUFFER=256

# ---------------------------------------------------------------- HTTP / CORS
# Comma-separated list of allowed browser origins (CORS and WebSocket Origin check).
# Empty = no browser origin is allowed. Native clients send no Origin and are unaffected.
# "*" is refused on purpose (requests are authenticated).
FLICKSYNC_CORS_ORIGINS=

# ---------------------------------------------------------------- metrics (optional)
# Prometheus text format on GET /metrics. Disabled unless enabled here.
FLICKSYNC_METRICS_ENABLED=false
# If set, /metrics requires "Authorization: Bearer <token>".
FLICKSYNC_METRICS_TOKEN=

# ---------------------------------------------------------------- internals
FLICKSYNC_SWEEP_INTERVAL_MS=1000
FLICKSYNC_SHUTDOWN_GRACE=10
