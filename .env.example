# Flick Server: first-start configuration. Copy to `.env`; docker compose reads it.
# Everything else (rooms, sync, chat, limits, FlickDD...) is set in the panel. Every variable and
# its default: docs/configuration.md. Variables still work as the fallback behind the panel.

# ---- Panel (on by default in docker-compose.yml)
# Sign-in password, 10+ characters (openssl rand -base64 18). The admin API token is derived from it.
PANEL_PASSWORD=
# Set false to run without the panel.
#ENABLE_WEB_PANEL=true

# ---- Access
# Public address clients use. Needed behind a reverse proxy, where the server cannot know it.
#FLICKSYNC_PUBLIC_URL=https://sync.example.com
# Your own signing keys, format kid:server_id:secret (unset = a key is generated and stored).
#FLICKSYNC_AUTH_KEYS=
#FLICKSYNC_AUTH_KEYS_FILE=/run/secrets/flicksync_keys

# ---- Modules
# Start FlickSync (Watch Together) at boot. The panel can also switch it; its choice wins.
#FLICKSYNC_ENABLED=false

# ---- Network and storage
#FLICKSYNC_HOST=0.0.0.0
#FLICKSYNC_PORT=8787
# Where the signing key and settings.json live. Keep it on a volume.
#FLICKSYNC_DATA_DIR=./data

# ---- Logs
#FLICKSYNC_LOG_LEVEL=info
# pretty | json
#FLICKSYNC_LOG_FORMAT=pretty
# Lines kept in memory for the panel's Logs page (0 = none, at most 10000). Lost on restart.
#FLICKSYNC_LOG_BUFFER=2000

# ---- Internals
#FLICKSYNC_SHUTDOWN_GRACE=10
#FLICKSYNC_SWEEP_INTERVAL_MS=1000
